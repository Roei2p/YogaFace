# --- Server ---
PORT=4000
DASHBOARD_API_TOKEN=change-me-to-a-long-random-string

# --- Database (SQLite file, single-file backup-friendly) ---
DATABASE_URL="file:./data/yogaface.db"

# --- Green API (WhatsApp) - https://green-api.com ---
# Create an instance in the Green API console, scan the QR code with the
# WhatsApp number that should manage the group, then copy these two values.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# The WhatsApp group's chat id, format: 1234567890-1234567890@g.us
# (get it once via GET /api/whatsapp/groups after linking the instance)
WHATSAPP_GROUP_ID=

# --- Cardcom (billing) ---
# Shared secret embedded in the webhook URL you configure in the Cardcom
# back-office, e.g. https://yourdomain.com/webhooks/cardcom/<this value>
CARDCOM_WEBHOOK_SECRET=change-me-too
# Optional: Cardcom API credentials, only needed for the reconciliation job
# that double-checks subscriber status against Cardcom directly.
# Verify the exact endpoint/fields against Cardcom's docs for your account
# type (Terminal number / API name / API password) before enabling.
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=

# --- AI insights chat (Anthropic Claude) ---
ANTHROPIC_API_KEY=

# --- Notifications (daily/weekly digest) ---
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_WHATSAPP_PHONE=
DIGEST_CRON="0 8 * * *"
RECONCILE_CRON="*/30 * * * *"
