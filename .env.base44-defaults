# Base44 dev-environment defaults. These are placeholders that let the app
# boot without real credentials. Real secrets are delivered via
# /run/base44/app.env (listed AFTER this file in compose env_file), so any
# key set there overrides these values.

PORT=4000
DATABASE_URL=file:/app/data/yogaface.db
NODE_ENV=development

# Optional integrations — left blank; the app runs fine without them.
# The user provides real values via the Base44 secrets dashboard.
CARDCOM_WEBHOOK_SECRET=dev-webhook-secret
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
DIGEST_CRON=0 8 * * *
RECONCILE_CRON=*/30 * * * *
