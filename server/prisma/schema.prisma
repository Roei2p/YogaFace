datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite has no native enum support in Prisma, so subscriptionStatus and
// groupStatus are plain strings. Valid values are enforced in application
// code - see server/src/types.ts.
model Member {
  id                 String   @id @default(cuid())
  name               String?
  phone              String   @unique
  cardcomCustomerId  String?  @unique
  subscriptionStatus String   @default("UNKNOWN")
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  lastPaymentAt      DateTime?
  lastPaymentAmount  Float?
  groupStatus        String   @default("NOT_IN_GROUP")
  groupStatusError   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  events             AuditEvent[]
  progress           LessonProgress[]
  sessions           StudentSession[]

  @@index([subscriptionStatus])
  @@index([groupStatus])
}

model AuditEvent {
  id        String   @id @default(cuid())
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id])
  type      String
  message   String
  payload   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

model Settings {
  id                  String  @id @default("singleton")
  whatsappGroupId     String?
  notifyEmail         String?
  notifyWhatsappPhone String?
}

// --- Course (student area) ---

model CourseModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String
  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Vimeo or YouTube link pasted by Noa; embedded in the player.
  videoUrl    String
  durationMin Int?
  order       Int              @default(0)
  published   Boolean          @default(true)
  progress    LessonProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([moduleId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([memberId, lessonId])
}

// One-time WhatsApp login codes. Only a hash of the code is stored.
model LoginCode {
  id        String   @id @default(cuid())
  memberId  String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
}

model StudentSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
